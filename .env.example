# 이 파일을 복사해 .env 를 만들고 값을 채운다 (.env 는 Git에 올라가지 않는다)
# cp .env.example .env

# BotFather가 준 봇 토큰
TELEGRAM_TOKEN=

# 내 ngrok 주소 (ngrok 대시보드 › Domains). https:// 부터 끝까지
NGROK_URL=

# AI
AI_PROVIDER=fake
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna

# 영화진흥위원회(KOBIS) 오픈API 인증키 — 박스오피스 (kobis.or.kr › 오픈API에서 무료 발급)
KOBIS_API_KEY=
